/* =========================================================
   GLOBAL
   ========================================================= */

QWidget {
    background-color: #1e1f26;
    color: #f2f3f5;
    font-family: "Segoe UI";
    font-size: 14px;
}

QMainWindow {
    background-color: #1e1f26;
}

#CentralWidget {
    background-color: #1e1f26;
}

#PageStack {
    background-color: #1e1f26;
}


/* =========================================================
   SIDEBAR
   ========================================================= */

#Sidebar {
    background-color: #17181f;
    border-right: 1px solid #2d2f3a;
}

#SidebarTitle {
    color: #ffffff;
    font-size: 26px;
    font-weight: 700;
    padding: 10px;
}


/* =========================================================
   SIDEBAR BUTTON
   ========================================================= */

#SidebarButton {
    background-color: transparent;
    color: #b9bcc8;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding-left: 18px;
    font-size: 15px;
    font-weight: 500;
}

#SidebarButton:hover {
    background-color: #252733;
    color: #ffffff;
}

#SidebarButton:checked {
    background-color: #4255ff;
    color: #ffffff;
    font-weight: 600;
}


/* =========================================================
   PAGE TITLES
   ========================================================= */

#PageTitle {
    color: #ffffff;
    font-size: 30px;
    font-weight: 700;
}

#SectionTitle {
    color: #ffffff;
    font-size: 20px;
    font-weight: 600;
}

#FieldLabel {
    color: #d7d9e0;
    font-size: 14px;
    font-weight: 600;
}


/* =========================================================
   TEXT
   ========================================================= */

#SecondaryText {
    color: #9396a5;
    font-size: 15px;
}

#EmptyMessage {
    color: #8c8f9d;
    font-size: 18px;
    padding: 30px;
}


/* =========================================================
   PRIMARY BUTTON
   ========================================================= */

#PrimaryButton {
    background-color: #4255ff;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 11px 20px;
    font-size: 16px;
    font-weight: 600;
    min-height: 40px;
}

#PrimaryButton:hover {
    background-color: #5364ff;
}

#PrimaryButton:pressed {
    background-color: #3243de;
}

#PrimaryButton:disabled {
    background-color: #35384a;
    color: #777b8d;
}


/* =========================================================
   SECONDARY BUTTON
   ========================================================= */

#SecondaryButton {
    background-color: #2b2d37;
    color: #e5e7eb;
    border: 1px solid #3d404c;
    border-radius: 8px;
    padding: 10px 17px;
    font-size: 15px;
    font-weight: 500;
    min-height: 38px;
}

#SecondaryButton:hover {
    background-color: #353844;
    border: 1px solid #505362;
}

#SecondaryButton:pressed {
    background-color: #252733;
}

#SecondaryButton:checked {
    background-color: #4255ff;
    border: 1px solid #4255ff;
    color: white;
}

#SecondaryButton:disabled {
    background-color: #272932;
    color: #666a77;
    border: 1px solid #33353e;
}


/* =========================================================
   DANGER BUTTON
   ========================================================= */

#DangerButton {
    background-color: #3c2529;
    color: #ffb6bd;
    border: 1px solid #66363d;
    border-radius: 8px;
    padding: 9px 16px;
    font-size: 14px;
    font-weight: 600;
}

#DangerButton:hover {
    background-color: #522d33;
    color: #ffffff;
}

#DangerButton:pressed {
    background-color: #6a333b;
}


/* =========================================================
   INPUT
   ========================================================= */

#MainInput,
#CardInput,
#DescriptionInput {
    background-color: #262832;
    color: #ffffff;
    border: 1px solid #3b3e49;
    border-radius: 8px;
    padding: 12px;
    selection-background-color: #4255ff;
}

#MainInput {
    font-size: 19px;
    min-height: 34px;
}

#MainInput:focus,
#CardInput:focus,
#DescriptionInput:focus {
    border: 1px solid #4255ff;
    background-color: #292b36;
}

#MainInput::placeholder,
#CardInput::placeholder {
    color: #747887;
}


/* =========================================================
   STUDY SET LIST
   ========================================================= */

#StudySetList {
    background-color: transparent;
    border: none;
    outline: none;
}

#StudySetList::item {
    background-color: #262832;
    color: #ffffff;
    border: 1px solid #343640;
    border-radius: 10px;
    padding: 14px;
    margin-top: 3px;
    margin-bottom: 3px;
}

#StudySetList::item:hover {
    background-color: #2c2f3b;
    border: 1px solid #454957;
}

#StudySetList::item:selected {
    background-color: #303a78;
    border: 1px solid #4255ff;
    color: white;
}


/* =========================================================
   FLASHCARD ROW
   ========================================================= */

#FlashcardRow {
    background-color: #252731;
    border: 1px solid #343742;
    border-radius: 10px;
}

#CardNumber {
    color: #9296a6;
    font-size: 14px;
    font-weight: 600;
}


/* =========================================================
   DELETE CARD BUTTON
   ========================================================= */

#DeleteCardButton {
    background-color: transparent;
    color: #b5b8c5;
    border: none;
    border-radius: 6px;
    font-size: 22px;
    font-weight: bold;
}

#DeleteCardButton:hover {
    background-color: #49282e;
    color: #ff7c89;
}

#DeleteCardButton:pressed {
    background-color: #5d3037;
}


/* =========================================================
   SCROLL AREA
   ========================================================= */

#CardScrollArea {
    background-color: transparent;
    border: none;
}

#CardScrollArea QWidget {
    background-color: transparent;
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

QScrollBar:vertical {
    background-color: #202129;
    width: 10px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #4b4f5e;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5c6070;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}


/* =========================================================
   FLASHCARD STUDY MODE
   ========================================================= */

#Flashcard {
    background-color: #ffffff;
    border: 1px solid #d5d8e2;
    border-radius: 18px;
    min-height: 360px;
}

#Flashcard:hover {
    border: 2px solid #4255ff;
}

#FlashcardSide {
    background-color: transparent;
    color: #4255ff;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 2px;
}

#FlashcardText {
    background-color: transparent;
    color: #20212a;
    font-size: 42px;
    font-weight: 700;
}

#FlashcardHint {
    background-color: transparent;
    color: #747887;
    font-size: 15px;
}

#FlashcardCounter {
    color: #e0e2e8;
    font-size: 19px;
    font-weight: 700;
}

#AgainButton,
#HardButton,
#GoodButton,
#EasyButton {
    min-width: 130px;
    min-height: 52px;
    padding: 8px 16px;
    border-radius: 9px;
    font-size: 17px;
    font-weight: 700;
}

#AgainButton {
    background-color: #4a252b;
    color: #ffb7c0;
    border: 1px solid #73404a;
}

#HardButton {
    background-color: #49371f;
    color: #ffd99a;
    border: 1px solid #765b32;
}

#GoodButton {
    background-color: #203d35;
    color: #a9ead5;
    border: 1px solid #376a5c;
}

#EasyButton {
    background-color: #26355a;
    color: #b9c9ff;
    border: 1px solid #425995;
}

#AgainButton:hover,
#HardButton:hover,
#GoodButton:hover,
#EasyButton:hover {
    border: 2px solid #ffffff;
}

#AgainButton:disabled,
#HardButton:disabled,
#GoodButton:disabled,
#EasyButton:disabled {
    background-color: #292b34;
    color: #686c79;
    border: 1px solid #363944;
}


/* =========================================================
   LEARN AND TEST MODES
   ========================================================= */

#LearnQuestionCard {
    background-color: #252731;
    border: 1px solid #3a3d49;
    border-radius: 16px;
    min-height: 230px;
}

#LearnTerm {
    background-color: transparent;
    color: #ffffff;
    font-size: 38px;
    font-weight: 700;
    padding: 20px 28px;
}

#LearnFeedback {
    background-color: transparent;
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
    padding: 6px;
}

#LearnModeCombo {
    background-color: #2b2d37;
    color: #ffffff;
    border: 1px solid #454957;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 34px;
    font-size: 16px;
}

#LearnModeCombo QAbstractItemView {
    background-color: #2b2d37;
    color: #ffffff;
    selection-background-color: #4255ff;
    font-size: 16px;
}

QRadioButton {
    color: #f0f1f5;
    font-size: 19px;
    spacing: 12px;
    padding: 10px 14px;
    min-height: 36px;
}

QRadioButton::indicator {
    width: 22px;
    height: 22px;
}

QRadioButton::indicator:unchecked {
    border: 2px solid #777c8d;
    border-radius: 12px;
    background-color: #20222b;
}

QRadioButton::indicator:checked {
    border: 6px solid #4255ff;
    border-radius: 12px;
    background-color: #ffffff;
}

QProgressBar {
    background-color: #292b35;
    color: #ffffff;
    border: 1px solid #3c3f4b;
    border-radius: 8px;
    min-height: 24px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
}

QProgressBar::chunk {
    background-color: #4255ff;
    border-radius: 7px;
}

#StudyProgressBar {
    min-height: 10px;
    max-height: 26px;
}


/* =========================================================
   LIST WIDGET
   ========================================================= */

QListWidget {
    outline: none;
}


/* =========================================================
   MESSAGE BOX
   ========================================================= */

QMessageBox {
    background-color: #24262f;
}

QMessageBox QLabel {
    background-color: transparent;
    color: #ffffff;
    font-size: 15px;
}

QMessageBox QPushButton {
    background-color: #333642;
    color: white;
    border: 1px solid #444855;
    border-radius: 6px;
    min-width: 90px;
    padding: 8px 16px;
    font-size: 14px;
}

QMessageBox QPushButton:hover {
    background-color: #4255ff;
    border: 1px solid #4255ff;
}


/* =========================================================
   TOOLTIP
   ========================================================= */

QToolTip {
    background-color: #2e303a;
    color: #ffffff;
    border: 1px solid #494c58;
    padding: 6px;
    border-radius: 4px;
}


/* =========================================================
   TEXT EDIT
   ========================================================= */

QTextEdit {
    background-color: #262832;
    color: #ffffff;
    border: 1px solid #3b3e49;
    border-radius: 8px;
    padding: 8px;
}


/* =========================================================
   LINE EDIT
   ========================================================= */

QLineEdit {
    background-color: #262832;
    color: #ffffff;
    border: 1px solid #3b3e49;
    border-radius: 8px;
    padding: 8px;
}


/* =========================================================
   BUTTON DEFAULT
   ========================================================= */

QPushButton {
    min-height: 34px;
}


/* =========================================================
   DISABLED
   ========================================================= */

QPushButton:disabled {
    color: #666a78;
}
